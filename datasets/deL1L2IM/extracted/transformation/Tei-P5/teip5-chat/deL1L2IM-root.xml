    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>: deL1L2IM Collection of German Native Speaker to Non-Native Speaker Instant
                    Messanger-based Dialogues</title>
                <funder>University of Luxembourg</funder>
                <respStmt>
                    <resp>Collected, annotated and converted to TEI-conformant markup by</resp>
                    <name>Sviatlana Hoehn (Danilava)</name>
                </respStmt>
                <respStmt>
                    <resp>Error and correction annotation</resp>
                    <name>Nicole Recklies</name>
                </respStmt>
                <respStmt>
                    <resp>Error and correction annotation</resp>
                    <name>Sviatlana Hoehn (Danilava)</name>
                </respStmt>
            </titleStmt>
            <editionStmt>
                <edition>First edition, <date>February 2014</date>
                </edition>
            </editionStmt>
            <extent>
                <measure unit="dialogues" quantity="72">72 dialogues</measure>
                <measure unit="messages" quantity="5000">4548 messages</measure>
            </extent>
            <publicationStmt>
                <!-- PUBLISHER???? -->
                <publisher>ELRA</publisher>
                <availability>
                    <p>Distributed under ELRA License</p>
                </availability>
                <date>2015</date>
            </publicationStmt>
            <sourceDesc>
                <p>Born digital.</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <projectDesc>
                <p>Chat dialogues collected for the purpose of a PhD project: design and
                    implementation of an Artificial Conversational Companion for conversation
                    training. the corpus is a side product of the project. See corpus documentation for more details.</p>
            </projectDesc>
            <samplingDecl>
                <p>Dialogues of about 30 minutes duration between NS and NNS of German who have
                    never met before, with 8 dialogues per pair. Communication via instant
                    messaging, text only (no file transfer, no speech), a forwarding chatbot is in
                    the middle. Participants know, that they are being recorded. The chatlogs are
                    available immediately from the chatbot data base. Protocol and client used:
                    XMPP, Google Talk. Devices used: PC, mobile phones.</p>
            </samplingDecl>
        </encodingDesc>
